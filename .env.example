# Copie para .env (que fica fora do git) e ajuste os valores.
SERVICE_NAME=os-service

# Mesmo segredo da Lambda autogiro-auth e do Kong; no mínimo 32 caracteres.
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

LOG_LEVEL=INFO
CORS_ORIGINS=*

# Conexões com o banco, a mensageria e o Execution Service.
DATABASE_URL=postgresql+asyncpg://autogiro:autogiro@db:5432/autogiro_os
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Catálogo de peças do Execution Service (opcional: sem ele, a Saga valida as peças).
EXECUTION_SERVICE_URL=http://host.docker.internal:8003
EXECUTION_SERVICE_TIMEOUT_SECONDS=2
