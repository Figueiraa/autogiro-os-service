# Copie para .env.ecossistema (fora do git) e preencha.

# Mesmo segredo nos 3 serviços (e na Lambda autogiro-auth): no mínimo 32 caracteres.
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

# Access Token das credenciais de teste do Mercado Pago (Checkout Pro).
MERCADOPAGO_ACCESS_TOKEN=

# Capacidade da fila da oficina. Com 0, toda OS paga é recusada na fila: é o jeito
# de provocar a falha depois do pagamento, com estorno.
EXECUTION_QUEUE_CAPACITY=20

# Prazos do pagamento e da resposta ao orçamento, em minutos.
PAYMENT_TIMEOUT_MINUTES=60
APPROVAL_TIMEOUT_MINUTES=1440

# Rastreamento distribuído no New Relic (opcional). Endpoint OTLP da conta (região
# US) e a license key de ingestão (a mesma do agente no cluster).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
NEW_RELIC_LICENSE_KEY=
